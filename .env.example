APP_NAME="Treck"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
# Timezone used only to DISPLAY timestamps (storage stays UTC). e.g. Asia/Karachi
TRECK_DISPLAY_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=treck
DB_USERNAME=treck_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

# Real-time presence (M7). Default "log" keeps everything working with no
# realtime server. For live dashboard updates install Laravel Reverb
# (composer require laravel/reverb), set BROADCAST_CONNECTION=reverb, fill the
# REVERB_* values, and run `php artisan reverb:start`.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (websocket server) — used when BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Exposed to the browser build (resources/js/echo.js)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@treck.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

VITE_APP_NAME="${APP_NAME}"

# --- Treck domain config (see config/treck.php) ---
TRECK_HEARTBEAT_INTERVAL=60
TRECK_IDLE_THRESHOLD=300
TRECK_OFFLINE_GRACE=180
TRECK_WORKDAY_START=09:00
TRECK_LATE_GRACE=15
TRECK_FULL_DAY_HOURS=8
TRECK_SCREENSHOTS=false
TRECK_RAW_RETENTION=90
TRECK_AGG_RETENTION=730
TRECK_AGENT_PROVISIONING_KEY=
