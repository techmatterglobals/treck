<Application x:Class="Treck.Admin.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0F172A" />
        <SolidColorBrush x:Key="PanelBackground" Color="#1E293B" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SecondaryText" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#38BDF8" />
    </Application.Resources>
</Application>
