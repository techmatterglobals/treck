<UserControl x:Class="Treck.Admin.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource WindowBackground}">
        <Border Width="440" Padding="40" CornerRadius="14" Background="{StaticResource PanelBackground}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Treck Admin" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                <TextBlock Text="Sign in with an authorized Admin or Manager account." Margin="0,8,0,28"
                           Foreground="{StaticResource SecondaryText}" />
                <TextBlock Text="Email address" Foreground="{StaticResource PrimaryText}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,18" Padding="12,10" />
                <TextBlock Text="Password" Foreground="{StaticResource PrimaryText}" />
                <PasswordBox x:Name="PasswordInput" Margin="0,8,0,20" Padding="12,10" KeyDown="PasswordInput_OnKeyDown" />
                <Button Content="Sign in" Padding="16,11" Click="SignIn_OnClick" />
                <TextBlock Text="{Binding ErrorMessage}" Margin="0,18,0,0" Foreground="#FCA5A5" TextWrapping="Wrap" />
                <TextBlock Text="Your password is sent only to the configured Treck server and is not stored."
                           Margin="0,20,0,0" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
