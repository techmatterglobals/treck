<UserControl x:Class="Treck.Admin.Desktop.Views.EmployeeDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Button Content="← Back to live presence" Padding="12,8" HorizontalAlignment="Left" Command="{Binding BackCommand}" />
            <TextBlock Text="{Binding Detail.Employee.Name}" Margin="0,22,0,0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
            <TextBlock Text="{Binding Detail.Employee.Designation}" Margin="0,4,0,0" Foreground="{StaticResource SecondaryText}" />
            <TextBlock Text="{Binding ErrorMessage}" Margin="0,12,0,0" Foreground="#FCA5A5" />
            <UniformGrid Columns="3" Margin="0,22,0,0">
                <Border Margin="0,0,12,0" Padding="20" CornerRadius="10" Background="{StaticResource PanelBackground}"><StackPanel><TextBlock Text="Status" Foreground="{StaticResource SecondaryText}" /><TextBlock Text="{Binding Detail.Today.Status}" FontSize="24" Foreground="{StaticResource PrimaryText}" /></StackPanel></Border>
                <Border Margin="0,0,12,0" Padding="20" CornerRadius="10" Background="{StaticResource PanelBackground}"><StackPanel><TextBlock Text="Active today" Foreground="{StaticResource SecondaryText}" /><TextBlock Text="{Binding Detail.Today.ActiveHours, StringFormat={}{0:0.00} hours}" FontSize="24" Foreground="#86EFAC" /></StackPanel></Border>
                <Border Padding="20" CornerRadius="10" Background="{StaticResource PanelBackground}"><StackPanel><TextBlock Text="Idle today" Foreground="{StaticResource SecondaryText}" /><TextBlock Text="{Binding Detail.Today.IdleHours, StringFormat={}{0:0.00} hours}" FontSize="24" Foreground="#FDE68A" /></StackPanel></Border>
            </UniformGrid>
            <TextBlock Text="Computers" Margin="0,26,0,10" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
            <ItemsControl ItemsSource="{Binding Detail.Computers}">
                <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="16" Background="{StaticResource PanelBackground}" CornerRadius="8"><DockPanel><TextBlock Text="{Binding ComputerName}" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" /><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource Accent}" /></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
