<UserControl x:Class="Treck.Admin.Desktop.Views.PresenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel><TextBlock Text="Live presence" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" /><TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource Accent}" /></StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding LastUpdatedAt, StringFormat={}Updated {0:T}}" Margin="0,9,14,0" Foreground="{StaticResource SecondaryText}" /><Button Content="Refresh now" Padding="14,8" Command="{Binding RefreshCommand}" /></StackPanel>
        </DockPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MouseDoubleClick="PresenceGrid_OnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Employee" Binding="{Binding Employee}" Width="2*" />
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="*" />
                <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                <DataGridTextColumn Header="Active seconds" Binding="{Binding ActiveSeconds}" Width="*" />
                <DataGridTextColumn Header="Idle seconds" Binding="{Binding IdleSeconds}" Width="*" />
                <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivityAt, StringFormat={}{0:G}}" Width="1.4*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
