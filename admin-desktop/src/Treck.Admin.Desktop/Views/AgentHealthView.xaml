<UserControl x:Class="Treck.Admin.Desktop.Views.AgentHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel>
                <TextBlock Text="Agent health" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource Accent}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{Binding LastUpdatedAt, StringFormat={}Updated {0:T}}" Margin="0,9,14,0" Foreground="{StaticResource SecondaryText}" />
                <Button Content="Refresh now" Padding="14,8" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="2" Columns="6">
            <StackPanel><TextBlock Text="Healthy" Foreground="{StaticResource SecondaryText}" /><TextBlock Text="{Binding Summary.Healthy}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" /></StackPanel>
            <StackPanel><TextBlock Text="Stale" Foreground="{StaticResource SecondaryText}" /><TextBlock Text="{Binding Summary.Stale}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" /></StackPanel>
            <StackPanel><TextBlock Text="Never reported" Foreground="{StaticResource SecondaryText}" /><TextBlock Text="{Binding Summary.NeverReported}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" /></StackPanel>
            <StackPanel><TextBlock Text="Outdated" Foreground="{StaticResource SecondaryText}" /><TextBlock Text="{Binding Summary.Outdated}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" /></StackPanel>
            <StackPanel><TextBlock Text="Pending" Foreground="{StaticResource SecondaryText}" /><TextBlock Text="{Binding Summary.PendingEvents}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" /></StackPanel>
            <StackPanel><TextBlock Text="Total" Foreground="{StaticResource SecondaryText}" /><TextBlock Text="{Binding Summary.Total}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" /></StackPanel>
        </UniformGrid>
        <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="*" />
                <DataGridTextColumn Header="Employee" Binding="{Binding Employee}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                <DataGridTextColumn Header="Version" Binding="{Binding AgentVersion}" Width="*" />
                <DataGridTextColumn Header="Compliance" Binding="{Binding VersionCompliance}" Width="*" />
                <DataGridTextColumn Header="Pending" Binding="{Binding PendingEventCount}" Width="*" />
                <DataGridCheckBoxColumn Header="Helper" Binding="{Binding HelperRunning}" Width="*" />
                <DataGridTextColumn Header="Session" Binding="{Binding HelperSessionId}" Width="*" />
                <DataGridTextColumn Header="Last sync" Binding="{Binding LastSuccessfulSyncAt, StringFormat={}{0:G}}" Width="1.35*" />
                <DataGridTextColumn Header="Last capture" Binding="{Binding LastCaptureAt, StringFormat={}{0:G}}" Width="1.35*" />
                <DataGridTextColumn Header="Last error" Binding="{Binding LastErrorCategory}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
