<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Treck.Agent</RootNamespace>
    <AssemblyName>TreckAgent</AssemblyName>
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Publish target RID. Declared here so `dotnet restore -r win-x64` and
         `dotnet publish -r win-x64` are recognized without extra flags. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- Framework-dependent by default: a `-r win-x64` restore/publish then pulls
         only the small apphost pack, NOT the ~130 MB win-x64 runtime packs
         (Microsoft.NETCore.App.Runtime + Microsoft.WindowsDesktop.App.Runtime —
         the latter is required because Microsoft.Win32.SystemEvents lives in the
         Windows Desktop shared framework). Target machines need the .NET 8
         Desktop Runtime installed. Opt into a self-contained build only when that
         is not acceptable (see agent/deploy/publish.ps1 -SelfContained), which
         requires downloading the runtime packs once on a connected build host.
         A command-line `--self-contained true` overrides this default. -->
    <SelfContained>false</SelfContained>

    <!-- The test project lives under tests/; never compile it into this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Production config is created per-deployment (gitignored); copy it to the
         publish output only when it exists so `dotnet publish` never fails. -->
    <None Update="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Production.json')" />
  </ItemGroup>

</Project>
