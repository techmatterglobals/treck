{
  "Agent": {
  "BaseUrl": "https://treck.rcmmattergroup.com",
  "ProvisioningKey": "set-per-deployment",
  "EmployeeCode": "EMP-0001",
  "HeartbeatIntervalSeconds": 600,
  "IdleThresholdSeconds": 300,
  "MaxRetries": 4
},
  "SessionMonitor": {
    "DuplicateSuppressionMilliseconds": 1000
  },
  "ApplicationTracking": {
    "Enabled": true,
    "IgnoredExecutables": [
      "explorer.exe",
      "SearchHost.exe",
      "SearchApp.exe",
      "LockApp.exe",
      "ShellExperienceHost.exe",
      "StartMenuExperienceHost.exe",
      "TextInputHost.exe"
    ],
    "IgnoredProcessNames": ["System", "Idle"],
    "MinimumSessionSeconds": 1,
    "MaxWindowTitleLength": 255
  },
  "Screenshots": {
    "Enabled": true,
    "IntervalSeconds": 600,
    "RandomJitterSeconds": 0,
    "CaptureOnlyWhenActive": true,
    "MultiMonitor": true,
    "Format": "jpeg",
    "JpegQuality": 60,
    "IgnoredProcesses": [],
    "IgnoredWindowTitles": []
  },
  "FileDownloads": {
    "Enabled": true,
    "WatchedFolders": [],
    "IncludeSubdirectories": true,
    "IgnoredExtensions": ["tmp", "crdownload", "part", "partial", "download"],
    "IgnoredApplications": [],
    "IgnoredFolders": [],
    "HashEnabled": false,
    "MaxHashBytes": 52428800,
    "StabilizationMilliseconds": 1500
  },
  "OfflineStore": {
    "SyncIntervalSeconds": 30,
    "MaxBackoffSeconds": 900,
    "BatchSize": 100,
    "MaxRows": 100000,
    "RetentionHours": 24,
    "MaxUploadAttempts": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/treck-agent-.jsonl",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
