<?xml version="1.0" encoding="utf-8"?>
<!--
  Treck Agent MSI (WiX v5).

  Installs the self-contained agent to C:\Program Files\TreckAgent, creates the
  writable data tree under C:\ProgramData\TreckAgent (preserved across upgrades),
  registers the TreckAgent Windows Service (LocalSystem, Automatic, restart on
  failure), and enrolls the computer by invoking the agent's own enrollment
  (TreckAgent.exe enroll mode) BEFORE the service starts. A failed enrollment
  rolls the whole install back so no half-configured service is left behind.

  The enrollment code is a hidden property + handled by a managed custom action,
  so it is never written to the MSI log. Runtime identity/credentials continue to
  use the agent's existing FileDeviceIdStore / DpapiTokenStore (nothing here
  stores or displays the token).

  Build-time preprocessor variables (see build-installer.ps1):
    PublishDir  – the self-contained `dotnet publish` output (default ..\publish)
    CaDir       – folder containing Treck.Agent.Installer.CA.dll
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifndef PublishDir ?><?define PublishDir = "..\publish" ?><?endif?>
  <?ifndef CaDir ?><?define CaDir = "ca\bin\Release" ?><?endif?>

  <Package Name="Treck Agent"
           Manufacturer="Treck"
           Version="1.0.0.0"
           UpgradeCode="8f6a2f1e-6d5b-4b2a-9c3d-2a1f7e4b90aa"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Treck Agent is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Never write the enrollment code (or the CA data carrying it) to the log. -->
    <Property Id="MsiHiddenProperties" Value="ENROLLMENT_CODE;BASE_URL;EnrollDevice" />

    <!-- Public, log-hidden inputs. Set by the bootstrapper UI or an msiexec
         command line (silent/GPO installs). -->
    <Property Id="ENROLLMENT_CODE" Secure="yes" />
    <Property Id="BASE_URL" Secure="yes" />

    <!-- Already-enrolled detection: an existing DPAPI token means an UPGRADE or
         repair, which must NOT ask for a code or re-enroll. -->
    <Property Id="TRECK_TOKEN_EXISTS">
      <DirectorySearch Id="SearchDataDir" Path="[CommonAppDataFolder]TreckAgent">
        <FileSearch Id="SearchToken" Name="token.dat" />
      </DirectorySearch>
    </Property>

    <Feature Id="Main" Title="Treck Agent" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="DataFolders" />
    </Feature>

    <!-- ================= Directories ================= -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TreckAgent" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataFolder" Name="TreckAgent">
        <Directory Id="DataConfig" Name="config" />
        <Directory Id="DataSecrets" Name="secrets" />
        <Directory Id="DataData" Name="data" />
        <Directory Id="DataLogs" Name="logs" />
      </Directory>
    </StandardDirectory>

    <!-- ================= Files + Service ================= -->
    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="*">
      <File Id="TreckAgentExe" Source="$(var.PublishDir)\TreckAgent.exe" KeyPath="yes" />

      <ServiceInstall Id="TreckAgentService"
                      Name="TreckAgent"
                      DisplayName="Treck Agent"
                      Description="Treck employee productivity and PC activity monitoring agent."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="yes" />

      <!-- Recovery: restart on 1st/2nd/subsequent failures; reset counter daily. -->
      <util:ServiceConfig ServiceName="TreckAgent"
                          FirstFailureActionType="restart"
                          SecondFailureActionType="restart"
                          ThirdFailureActionType="restart"
                          RestartServiceDelayInSeconds="5"
                          ResetPeriodInDays="1" />

      <!-- Start after enrollment; stop + remove on uninstall. -->
      <ServiceControl Id="TreckAgentServiceControl"
                      Name="TreckAgent"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <!-- Everything else from the self-contained publish (auto-harvested). -->
    <ComponentGroup Id="PublishedFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" Exclude="$(var.PublishDir)\TreckAgent.exe" />
    </ComponentGroup>

    <!-- Writable data tree. Permanent => preserved on uninstall/upgrade so the
         device id, DPAPI token and offline queue survive. secrets/ is locked to
         SYSTEM + Administrators (DPAPI already protects the token; this is
         defense in depth). -->
    <Component Id="DataFolders" Directory="DataFolder" Guid="*" Permanent="yes">
      <CreateFolder />
      <CreateFolder Directory="DataConfig" />
      <CreateFolder Directory="DataData" />
      <CreateFolder Directory="DataLogs" />
      <CreateFolder Directory="DataSecrets">
        <!-- Protected DACL: SYSTEM (SY) + BUILTIN\Administrators (BA) full; no
             inheritance => ordinary Users have no access. -->
        <util:PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
      <RegistryValue Root="HKLM" Key="SOFTWARE\Treck\Agent" Name="DataDir"
                     Type="string" Value="[DataFolder]" KeyPath="yes" />
    </Component>

    <!-- ================= Enrollment (deferred, before service start) ================= -->
    <Binary Id="EnrollCA" SourceFile="$(var.CaDir)\Treck.Agent.Installer.CA.dll" />

    <!-- Marshal the (hidden) inputs to the deferred CA. The property name matches
         the deferred action id, so this becomes its CustomActionData. -->
    <SetProperty Id="EnrollDevice"
                 Before="EnrollDevice"
                 Sequence="execute"
                 Value="Exe=[#TreckAgentExe];Code=[ENROLLMENT_CODE];BaseUrl=[BASE_URL]"
                 Condition="NOT Installed AND NOT TRECK_TOKEN_EXISTS" />

    <CustomAction Id="EnrollDevice"
                  BinaryRef="EnrollCA"
                  DllEntry="EnrollDevice"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <!-- After files exist, before the service is started. Fresh installs only. -->
      <Custom Action="EnrollDevice" Before="StartServices"
              Condition="NOT Installed AND NOT TRECK_TOKEN_EXISTS" />
    </InstallExecuteSequence>

  </Package>
</Wix>
