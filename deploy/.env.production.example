# Treck — production environment template (copy to .env and fill in secrets).
# NEVER commit the real .env. Keep secrets in your secret manager / CI.

APP_NAME="Treck"
APP_ENV=production
APP_KEY=                       # php artisan key:generate
APP_DEBUG=false
APP_URL=https://treck.example.com
APP_TIMEZONE=UTC
# Timezone used only to DISPLAY timestamps (storage stays UTC). e.g. Asia/Karachi
TRECK_DISPLAY_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=treck
DB_USERNAME=treck_user
DB_PASSWORD=                   # strong secret

# --- Redis (cache / queue / sessions / live status) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                # set requirepass on Redis

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=treck.example.com

# --- Mail (alerts, exports, backup notifications) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@treck.example.com"

# --- Treck domain config ---
TRECK_HEARTBEAT_INTERVAL=60
TRECK_IDLE_THRESHOLD=300
TRECK_OFFLINE_GRACE=180
TRECK_WORKDAY_START=09:00
TRECK_LATE_GRACE=15
TRECK_FULL_DAY_HOURS=8
TRECK_SCREENSHOTS=false
TRECK_RAW_RETENTION=90
TRECK_AGG_RETENTION=730
TRECK_AGENT_ENROLLMENT_SECRET=  # rotate; one-time enrollment secret used by new devices

# --- Backups (spatie/laravel-backup → offsite) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# --- Error tracking (optional) ---
SENTRY_LARAVEL_DSN=
